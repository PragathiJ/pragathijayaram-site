---
import { FOOTER_LINKS, SITE_TITLE, SOCIAL } from '../consts';

const year = new Date().getFullYear();
---

<footer>
	<div class="wrap inner">
		<p class="meta">&copy; {year} {SITE_TITLE}</p>
		<nav aria-label="Footer">
			{FOOTER_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
			<a href={SOCIAL.github} rel="me noopener">GitHub</a>
			<a href={SOCIAL.linkedin} rel="me noopener">LinkedIn</a>
		</nav>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--hairline);
	}

	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		padding-block: 1.5rem 2.5rem;
	}

	p {
		margin: 0;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		font-size: 0.875rem;
	}

	nav a {
		color: var(--muted);
		text-decoration: none;
	}

	nav a:hover {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>
