---
import ArticleRow, { type Row } from './ArticleRow.astro';
import type { Group } from '../data/groups';

interface Props {
	group: Group;
	rows: Row[];
}

const { group, rows } = Astro.props;
const published = rows.filter((row) => row.href);
const upcoming = rows.filter((row) => !row.href);
---

<section id={group.id}>
	<h2>{group.name}</h2>
	<p class="blurb">{group.blurb}</p>
	{published.map((row) => <ArticleRow {...row} />)}
	{
		upcoming.length > 0 && (
			<>
				<p class="upcoming">Upcoming</p>
				{upcoming.map((row) => (
					<ArticleRow {...row} />
				))}
			</>
		)
	}
</section>

<style>
	section {
		margin-bottom: 3.5rem;
	}

	h2 {
		border-bottom: 2px solid var(--ink);
		padding-bottom: 0.35rem;
		margin-bottom: 0.5rem;
	}

	.blurb {
		color: var(--muted);
		margin-bottom: 1rem;
	}

	.upcoming {
		font-family: var(--font-sans);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
		margin-top: 1.75rem;
		margin-bottom: 0.25rem;
	}
</style>
