---
import { NAV, SITE_TITLE } from '../consts';
import NavLink from './NavLink.astro';
---

<header>
	<div class="wrap bar">
		<a href="/" class="name">{SITE_TITLE}</a>
		<nav aria-label="Main">
			{NAV.map((item) => <NavLink href={item.href}>{item.label}</NavLink>)}
		</nav>
	</div>
</header>

<style>
	header {
		border-bottom: 1px solid var(--hairline);
	}

	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		padding-block: 1.25rem;
	}

	.name {
		font-family: var(--font-serif);
		font-size: var(--step-1);
		color: var(--ink);
		text-decoration: none;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		font-size: 0.9375rem;
	}
</style>
