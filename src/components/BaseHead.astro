---
import '../styles/global.css';
import { AUTHOR, SITE_TITLE, SOCIAL, DEFAULT_OG_IMAGE } from '../consts';

interface Props {
	title: string;
	description: string;
	ogImage?: string;
	pubDate?: Date;
	updatedDate?: Date;
	person?: boolean;
}

const {
	title,
	description,
	ogImage = DEFAULT_OG_IMAGE,
	pubDate,
	updatedDate,
	person,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const pageTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;

// Every article points its author at this one @id, so the articles, the About
// page, GitHub and LinkedIn resolve to a single person rather than four names.
const personURL = new URL('/about/', Astro.site).href;
const personId = `${personURL}#person`;
const sameAs = [SOCIAL.linkedin, SOCIAL.github];

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	'@id': personId,
	name: AUTHOR.name,
	url: personURL,
	jobTitle: AUTHOR.jobTitle,
	description: AUTHOR.description,
	knowsAbout: AUTHOR.knowsAbout,
	alumniOf: { '@type': 'CollegeOrUniversity', name: AUTHOR.alumniOf },
	address: { '@type': 'PostalAddress', addressCountry: 'DE' },
	sameAs,
};

const articleSchema = pubDate
	? {
			'@context': 'https://schema.org',
			'@type': 'Article',
			headline: title,
			description,
			image: ogImageURL.href,
			datePublished: pubDate.toISOString(),
			dateModified: (updatedDate ?? pubDate).toISOString(),
			url: canonicalURL.href,
			mainEntityOfPage: canonicalURL.href,
			inLanguage: 'en',
			author: { '@type': 'Person', '@id': personId, name: AUTHOR.name, url: personURL, sameAs },
		}
	: null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
<!-- An exact-size PNG stops browsers reaching for the opaque apple-touch icon
     when they want a crisp tab icon, which showed as a pale box on dark chrome. -->
<link rel="icon" type="image/png" href="/icon-32.png" sizes="32x32" />
<link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<link rel="canonical" href={canonicalURL} />

<title>{pageTitle}</title>
<meta name="description" content={description} />

<meta property="og:type" content={pubDate ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:site_name" content={SITE_TITLE} />
{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

{articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
{person && <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />}

<script
	is:inline
	type="module"
	src="https://static.cloudflareinsights.com/beacon.min.js"
	data-cf-beacon='{"token": "b48d3a023da549588e41be74b5c25a41"}'></script>
