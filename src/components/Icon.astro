---
// Line icons drawn in currentColor, so they follow the text tone and dark mode.
export type IconName =
	| 'phone-check'
	| 'alert'
	| 'upgrade'
	| 'play'
	| 'card'
	| 'nodes'
	| 'shield'
	| 'chat'
	| 'mail'
	| 'arrow'
	| 'apple'
	| 'star'
	| 'clock'
	| 'layers'
	| 'calendar';

interface Props {
	name: IconName;
	size?: number;
	class?: string;
}

const { name, size = 24, class: className } = Astro.props;

const PATHS: Record<IconName, string> = {
