	upgrade: 'M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6zM12 16V8M8.5 11.5 12 8l3.5 3.5',
	play: 'M7 4.5v15l12-7.5-12-7.5z',
	card: 'M3 8a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8zM3 10.5h18M7 14.5h4',
	nodes: 'M6 6m-2 0a2 2 0 1 0 4 0 2 2 0 1 0-4 0M18 6m-2 0a2 2 0 1 0 4 0 2 2 0 1 0-4 0M12 18m-2 0a2 2 0 1 0 4 0 2 2 0 1 0-4 0M7 7.7l4 8.3M17 7.7l-4 8.3M8 6h8',
	shield: 'M12 3l7 2.6V11c0 4.4-3 8.1-7 10-4-1.9-7-5.6-7-10V5.6L12 3zM9.5 12l2 2 3.5-4',
	chat: 'M4 5h16v10H9l-5 4V5z',
	mail: 'M3 6a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6zM3 7l9 6 9-6',
	arrow: 'M5 12h14M13 6l6 6-6 6',
	apple: 'M15.5 3.5c-1.2.1-2.3.8-2.9 1.7-.6.8-1 1.9-.8 3 1.3.1 2.4-.6 3-1.5.6-.8 1-1.9.7-3.2zM12 8.8c-1.1 0-2.6-.9-3.9-.9-2 0-4.1 1.7-4.1 5 0 3.3 2.5 8.1 4.4 8.1 1.1 0 1.6-.8 3.3-.8s2.1.8 3.3.8c1.9 0 4.3-4.6 4.3-5.3-2.3-1-2.9-4.5-.5-5.8-1-1.3-2.4-1.9-3.4-1.9-1.5 0-2.3.8-3.4.8z',
