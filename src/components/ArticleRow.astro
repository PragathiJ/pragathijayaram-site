---
import FormattedDate from './FormattedDate.astro';
import Pill from './Pill.astro';

export interface Row {
	title: string;
	href?: string;
	description?: string;
	date?: Date;
	type?: string;
}

const { title, href, description, date, type } = Astro.props as Row;
---

<article class="row">
	<h3>{href ? <a href={href}>{title}</a> : <span>{title}</span>}</h3>
	{
		/* Planned rows sit under an "Upcoming" label, so a per-row pill would say
		   the same thing twice. They carry no date or type either, hence no meta line. */
		(date || type) && (
			<p class="meta">
				{date && <FormattedDate date={date} />}
				{date && type && <span aria-hidden="true">·</span>}
				{type && <span>{type}</span>}
				{href && <Pill status="published" />}
			</p>
		)
	}
	{description && <p class="description">{description}</p>}
</article>

<style>
	.row {
		padding-block: 1.25rem;
		border-bottom: 1px solid var(--hairline);
	}

	.row:last-child {
		border-bottom: 0;
	}

	h3 {
		font-size: var(--step-1);
		margin-bottom: 0.35rem;
	}

	h3 a {
		color: var(--ink);
		text-decoration: none;
	}

	h3 a:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	h3 span {
		color: var(--muted);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.35rem;
	}

	.description {
		margin: 0;
		color: var(--muted);
	}
</style>
