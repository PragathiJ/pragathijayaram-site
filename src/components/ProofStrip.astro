---
import Icon, { type IconName } from './Icon.astro';

// The receipts, as a single row. Shared by home and services.
const PROOF: { icon: IconName; text: string }[] = [
	{ icon: 'apple', text: 'Live on the App Store' },
	{ icon: 'play', text: 'Live on Google Play' },
	{ icon: 'star', text: 'Approved on the first submission' },
	{ icon: 'clock', text: 'Ten years shipping software' },
];
---

<ul class="proof">
	{
		PROOF.map((item) => (
			<li>
				<Icon name={item.icon} size={20} />
				<span>{item.text}</span>
			</li>
		))
	}
</ul>

<style>
	.proof {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 2rem;
		list-style: none;
		margin: 0 0 4rem;
		padding: 1rem 0;
		border-top: 1px solid var(--hairline);
		border-bottom: 1px solid var(--hairline);
		color: var(--muted);
		font-size: 0.9375rem;
	}

	.proof li {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.proof svg {
		color: var(--accent);
		flex: none;
	}
</style>
