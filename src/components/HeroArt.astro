---
// Services hero: a phone with a checked list, approved stamp, and two store tiles.
// Drawn with the site tokens so it holds in both themes.
---

<svg
	class="hero-art"
	viewBox="0 0 360 300"
	fill="none"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	<!-- soft backdrop -->
	<circle cx="200" cy="150" r="120" fill="var(--tint)"></circle>

	<!-- phone -->
	<rect x="120" y="30" width="140" height="250" rx="22" fill="var(--bg)" stroke="var(--ink)" stroke-width="2.5"></rect>
	<rect x="132" y="42" width="116" height="226" rx="14" fill="var(--surface)"></rect>
	<rect x="170" y="48" width="40" height="6" rx="3" fill="var(--hairline)"></rect>

	<!-- checklist on screen -->
	<g stroke="var(--accent)" stroke-width="2.2">
		<rect x="146" y="76" width="18" height="18" rx="5" fill="var(--tint)"></rect>
		<path d="M150 85l4 4 7-8"></path>
		<rect x="146" y="112" width="18" height="18" rx="5" fill="var(--tint)"></rect>
		<path d="M150 121l4 4 7-8"></path>
		<rect x="146" y="148" width="18" height="18" rx="5" fill="var(--tint)"></rect>
		<path d="M150 157l4 4 7-8"></path>
		<rect x="146" y="184" width="18" height="18" rx="5" fill="none" stroke="var(--muted)" stroke-dasharray="3 3"></rect>
	</g>
	<g fill="var(--hairline)">
		<rect x="174" y="80" width="56" height="5" rx="2.5"></rect>
		<rect x="174" y="89" width="38" height="5" rx="2.5"></rect>
		<rect x="174" y="116" width="50" height="5" rx="2.5"></rect>
		<rect x="174" y="125" width="30" height="5" rx="2.5"></rect>
		<rect x="174" y="152" width="58" height="5" rx="2.5"></rect>
		<rect x="174" y="161" width="42" height="5" rx="2.5"></rect>
		<rect x="174" y="188" width="46" height="5" rx="2.5"></rect>
		<rect x="174" y="197" width="34" height="5" rx="2.5"></rect>
	</g>

	<!-- approved stamp -->
	<g transform="translate(236 24)">
		<circle cx="24" cy="24" r="24" fill="var(--accent)"></circle>
		<path d="M14 25l7 7 13-14" stroke="var(--on-accent)" stroke-width="3.5"></path>
	</g>

	<!-- store tiles -->
	<g transform="translate(40 190)">
		<rect width="64" height="64" rx="16" fill="var(--bg)" stroke="var(--ink)" stroke-width="2"></rect>
		<path
			transform="translate(14 12) scale(1.5)"
			d="M15.5 3.5c-1.2.1-2.3.8-2.9 1.7-.6.8-1 1.9-.8 3 1.3.1 2.4-.6 3-1.5.6-.8 1-1.9.7-3.2zM12 8.8c-1.1 0-2.6-.9-3.9-.9-2 0-4.1 1.7-4.1 5 0 3.3 2.5 8.1 4.4 8.1 1.1 0 1.6-.8 3.3-.8s2.1.8 3.3.8c1.9 0 4.3-4.6 4.3-5.3-2.3-1-2.9-4.5-.5-5.8-1-1.3-2.4-1.9-3.4-1.9-1.5 0-2.3.8-3.4.8z"
			fill="var(--ink)"
		></path>
	</g>
	<g transform="translate(272 200)">
		<rect width="64" height="64" rx="16" fill="var(--bg)" stroke="var(--ink)" stroke-width="2"></rect>
		<path d="M22 16v32l26-16z" fill="var(--accent)"></path>
	</g>

	<!-- connectors -->
	<path d="M104 222c20 0 30-10 36-30" stroke="var(--muted)" stroke-width="1.5" stroke-dasharray="4 4"></path>
	<path d="M272 232c-20 0-30-10-36-30" stroke="var(--muted)" stroke-width="1.5" stroke-dasharray="4 4"></path>
</svg>

<style>
	.hero-art {
		width: 100%;
		height: auto;
		max-width: 360px;
		display: block;
	}
</style>
