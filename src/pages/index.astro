---
import Base from '../layouts/Base.astro';
import ArticleRow from '../components/ArticleRow.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublishedArticles, toRow } from '../lib/articles';

const latest = (await getPublishedArticles()).slice(0, 3);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<h1>
		I build AI and mobile products end to end, and publish the evidence of how they were built.
	</h1>
	<p class="intro">
		I'm an AI/ML engineer based in Germany. I've built machine learning systems in automotive and
		industrial settings, and most recently shipped Anovi, a nutrition app, on my own, from the
		database schema to the App Store. I write about production AI, mobile engineering, and building
		software in regulated spaces. Mostly the parts that are hard: the bugs, the architecture calls,
		and the compliance work nobody warns you about.
	</p>

	{
		latest.length > 0 && (
			<section>
				<h2>Latest</h2>
				{latest.map((article) => (
					<ArticleRow {...toRow(article)} />
				))}
			</section>
		)
	}

	<p class="links">
		<a href="/articles">All articles</a>
		<a href="/services">Work with me</a>
	</p>
</Base>

<style>
	h1 {
		max-width: 34rem;
	}

	.intro {
		color: var(--muted);
		margin-bottom: 3rem;
	}

	section {
		margin-bottom: 2.5rem;
	}

	h2 {
		font-size: var(--step-1);
		border-bottom: 2px solid var(--ink);
		padding-bottom: 0.35rem;
	}

	.links {
		display: flex;
		gap: 1.5rem;
		font-size: 0.9375rem;
	}
</style>
