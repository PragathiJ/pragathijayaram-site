---
import Base from '../layouts/Base.astro';
import ArticleRow from '../components/ArticleRow.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublishedArticles, toRow } from '../lib/articles';

const latest = (await getPublishedArticles()).slice(0, 3);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<h1>Production AI, mobile engineering, and the evidence behind both.</h1>
	<div class="intro">
		<p>Hey, I'm Pragathi, an AI/ML engineer based in Germany.</p>
		<p>
			My experience spans building machine learning systems for automotive and industrial
			applications and shipping complete products independently. Most recently, I built and
			launched Anovi, a full-stack nutrition app, from the database schema to the App Store.
		</p>
		<p>
			This site is a living record of what it takes to build and ship software in complex spaces. I
			write about production AI, mobile architecture, and navigating technical and regulatory
			constraints, documenting the breakthroughs, breaking points, and engineering trade-offs along
			the way.
		</p>
	</div>

	{
		latest.length > 0 && (
			<section>
				<h2>Latest</h2>
				{latest.map((article) => (
					<ArticleRow {...toRow(article)} />
				))}
			</section>
		)
	}

	<p class="links">
		<a href="/articles">All articles</a>
		<a href="/services">Work with me</a>
	</p>
</Base>

<style>
	.intro {
		color: var(--muted);
		margin-bottom: 3rem;
	}

	.intro p:last-child {
		margin-bottom: 0;
	}

	section {
		margin-bottom: 2.5rem;
	}

	h2 {
		font-size: var(--step-1);
		border-bottom: 2px solid var(--ink);
		padding-bottom: 0.35rem;
	}

	.links {
		display: flex;
		gap: 1.5rem;
		font-size: 0.9375rem;
	}
</style>
