---
import Base from '../layouts/Base.astro';
import ArticleRow from '../components/ArticleRow.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublishedArticles, toRow } from '../lib/articles';

const latest = (await getPublishedArticles()).slice(0, 3);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<h1>Applied AI, mobile and backend systems, grounded in evidence and built to ship.</h1>
	<div class="intro">
		<img
			class="portrait"
			src="/pragathi.jpg"
			alt=""
			width="88"
			height="88"
			decoding="async"
		/>
		<p>
			Hey, I'm Pragathi. I'm an applied AI systems consultant, product engineer and founder with 10
			years of experience building software, intelligent systems and digital products.
		</p>
		<p>
			My work spans embedded engineering, production AI, mobile and backend systems, and
			zero-to-one product development. After working at Bosch and Mercedes-Benz, I built and
			launched Anovi independently, taking it from product architecture and recommendation logic
			through backend development, mobile release and the App Store.
		</p>
		<p>
			This site is where I document the decisions behind reliable products: what worked, what
			failed, what the evidence showed and what it took to ship.
		</p>
	</div>

	{
		latest.length > 0 && (
			<section>
				<h2>Latest</h2>
				{latest.map((article) => (
					<ArticleRow {...toRow(article)} />
				))}
			</section>
		)
	}

	<p class="links">
		<a href="/articles">All articles</a>
		<a href="/services">Work with me</a>
	</p>
</Base>

<style>
	.intro {
		color: var(--muted);
		margin-bottom: 3rem;
	}

	/* Identification, not a hero. Floats so the first paragraph starts level with
	   it and the rest of the intro runs full width underneath. */
	.portrait {
		float: left;
		width: 88px;
		height: 88px;
		border-radius: 50%;
		object-fit: cover;
		shape-outside: circle(50%);
		shape-margin: 0.7rem;
		margin: 0.2rem 1.15rem 0.5rem 0;
	}

	.intro p:last-child {
		margin-bottom: 0;
	}

	section {
		margin-bottom: 2.5rem;
	}

	h2 {
		font-size: var(--step-1);
		border-bottom: 2px solid var(--ink);
		padding-bottom: 0.35rem;
	}

	.links {
		display: flex;
		gap: 1.5rem;
		font-size: 0.9375rem;
	}
</style>
