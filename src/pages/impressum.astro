---
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL } from '../consts';
---

<Base title="Impressum" description="Anbieterkennzeichnung nach § 5 DDG.">
	<h1>Impressum</h1>

	<div class="prose">
		<h2>Angaben gemäß § 5 DDG</h2>
		<p>
			Pragathi Jayaram<br />
			Karlsruher Straße 32<br />
			70771 Leinfelden-Echterdingen<br />
			Deutschland
		</p>

		<h2>Kontakt</h2>
		<p>E-Mail: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>

		<h2>Umsatzsteuer-Identifikationsnummer</h2>
		<p>Umsatzsteuer-Identifikationsnummer gemäß § 27a Umsatzsteuergesetz: DE462500932</p>

		<h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
		<p>Pragathi Jayaram (Anschrift wie oben)</p>

		<h2>Haftung für Inhalte</h2>
		<p>
			Als Diensteanbieterin bin ich gemäß § 7 Abs. 1 DDG für eigene Inhalte auf diesen Seiten nach
			den allgemeinen Gesetzen verantwortlich. Nach §§ 8 bis 10 DDG bin ich als Diensteanbieterin
