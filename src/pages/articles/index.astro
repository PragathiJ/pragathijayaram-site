---
import Base from '../../layouts/Base.astro';
import GroupBlock from '../../components/GroupBlock.astro';
import { GROUPS } from '../../data/groups';
import { getPublishedArticles, rowsByGroup } from '../../lib/articles';

const rows = rowsByGroup(await getPublishedArticles());
---

<Base
	title="Articles"
	description="Investigations and notes on production AI, mobile engineering, and building software in regulated spaces."
>
	<h1>Articles</h1>
	<p class="intro">
		Three lines of work. Planned pieces are listed so you can see where each one is going.
	</p>
	{GROUPS.map((group) => <GroupBlock group={group} rows={rows.get(group.id) ?? []} />)}
</Base>

<style>
	.intro {
		color: var(--muted);
		margin-bottom: 3rem;
	}
</style>
