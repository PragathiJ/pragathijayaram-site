---
import Base from '../../layouts/Base.astro';
import GroupBlock from '../../components/GroupBlock.astro';
import { GROUPS } from '../../data/groups';
import { getPublishedArticles, rowsByGroup } from '../../lib/articles';

const rows = rowsByGroup(await getPublishedArticles());

// A group appears only once it has something to read. It returns on its own the
// day its first article publishes.
const visibleGroups = GROUPS.filter((group) => (rows.get(group.id) ?? []).some((row) => row.href));
---

<Base
	title="Articles"
	description="Investigations and notes on production AI, mobile engineering, and building software in regulated spaces."
	wide
>
	<div class="head">
		<p class="eyebrow">Articles</p>
		<h1>Field notes from shipping real products.</h1>
		<p class="intro">
			Investigations and notes on production AI, mobile engineering and building in regulated spaces.
			Every claim has a receipt: an upstream issue, a reproduction, a measurement or a control.
		</p>
		<p class="jump">
			{visibleGroups.map((group) => <a href={`#${group.id}`}>{group.name}</a>)}
		</p>
	</div>
	{visibleGroups.map((group) => <GroupBlock group={group} rows={rows.get(group.id) ?? []} />)}
</Base>

<style>
	.head {
		margin-bottom: 3rem;
		max-width: 46rem;
	}

	h1 {
		font-size: clamp(2rem, 4vw, 2.75rem);
		margin: 0.35rem 0 0.75rem;
	}

	.intro {
		color: var(--muted);
		font-size: var(--step-1);
		margin-bottom: 1rem;
	}

	.jump {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
	}

	.jump a {
		font-size: 0.875rem;
		font-weight: 600;
		padding: 0.3rem 0.75rem;
		border-radius: 999px;
		border: 1px solid var(--hairline);
		text-decoration: none;
	}

	.jump a:hover {
		background: var(--tint);
	}
</style>
