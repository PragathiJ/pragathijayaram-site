---
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL } from '../consts';
import { OFFERS } from '../data/services';
---

<Base
	title="Work with me"
	description="Selected work across mobile apps, production AI features, backend engineering, zero to one product development, and technical writing."
>
	<h1>Work with me</h1>
	<p class="intro">
		I take on selected projects where I can contribute across engineering, product, and delivery. If
		one of these matches what you are building, email me with the problem, the current state, and
		what you need help shipping.
	</p>

	{
		OFFERS.map((offer) => (
			<section>
				<h2>{offer.title}</h2>
				<p>{offer.description}</p>
			</section>
		))
	}

	<p class="cta">
		<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
	</p>
</Base>

<style>
	.intro {
		margin-bottom: 2.5rem;
	}

	section {
		padding-bottom: 1.5rem;
		margin-bottom: 1.5rem;
		border-bottom: 1px solid var(--hairline);
	}

	h2 {
		font-size: var(--step-1);
		margin-bottom: 0.4rem;
	}

	section p {
		margin: 0;
		color: var(--muted);
	}

	.cta {
		font-family: var(--font-serif);
		font-size: var(--step-1);
		margin-top: 2rem;
	}
</style>
