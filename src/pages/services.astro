---
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL } from '../consts';
import { OFFERS } from '../data/services';
---

<Base
	title="Work with me"
	description="Engineering ownership across architecture, implementation, evaluation and release: mobile products, production AI and LLM systems, backend architecture, and zero-to-one product engineering."
>
	<h1>Work with me</h1>
	<div class="intro">
		<p>
			I work with teams that need experienced engineering ownership across architecture,
			implementation, evaluation and release.
		</p>
		<p>
			I take on selected projects where the technical path is not yet clear, an AI feature needs to
			move beyond a prototype, or a product needs senior support to reach a dependable release.
		</p>
		<p>
			Tell me what you are building, where it currently stands and what is preventing it from moving
			forward.
		</p>
	</div>

	{
		OFFERS.map((offer) => (
			<section>
				<h2>{offer.title}</h2>
				<p>{offer.description}</p>
			</section>
		))
	}

	<p class="prompt">
		Have a technically demanding product, AI system or engineering problem? Email me with a short
		description of the product, its current state and the outcome you need.
	</p>

	<p class="cta">
		<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
	</p>
</Base>

<style>
	.intro {
		margin-bottom: 2.5rem;
	}

	.intro p:last-child {
		margin-bottom: 0;
	}

	.prompt {
		margin-top: 2rem;
		margin-bottom: 0.75rem;
	}

	section {
		padding-bottom: 1.5rem;
		margin-bottom: 1.5rem;
		border-bottom: 1px solid var(--hairline);
	}

	h2 {
		font-size: var(--step-1);
		margin-bottom: 0.4rem;
	}

	section p {
		margin: 0;
		color: var(--muted);
	}

	.cta {
		font-family: var(--font-serif);
		font-size: var(--step-1);
		margin-top: 0;
	}
</style>
