---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { BUILDING, EXPERIENCE, PROJECTS } from '../data/portfolio';
---

<Base
	title="Portfolio"
	description="Anovi, a nutrition app shipped solo from schema to the App Store and Google Play, and an upstream React Native issue with a public reproducer."
	wide
>
	<h1>Portfolio</h1>
	<p class="intro">
		Work with public receipts, what I am building now, and the ten years behind both.
	</p>

	{
		PROJECTS.map((project) => (
			<article class="card project">
				<div class="cols">
					<div class="copy">
						<p class="eyebrow">{project.meta}</p>
						<h2>{project.name}</h2>
						{project.body.map((paragraph) => (
							<p>{paragraph}</p>
						))}
						<p class="links">
							{project.links.map((link, i) => (
								<Button href={link.href} primary={i === 0}>
									{link.label}
								</Button>
							))}
						</p>
					</div>
					{project.shots && (
						<div class="shots">
							{project.shots.map((shot, i) => (
								<a href={shot.src} style={`--i: ${i}`}>
									<img
										src={shot.src}
										alt={shot.alt}
										width="400"
										height="869"
										loading="lazy"
										decoding="async"
									/>
								</a>
							))}
						</div>
					)}
				</div>
			</article>
		))
	}

	<section class="building card">
		<h2>Currently building</h2>
		<ul>
			{BUILDING.map((item) => <li>{item}</li>)}
		</ul>
	</section>

	<section class="experience">
		<h2>Experience</h2>
		<p class="intro">Ten years, from embedded automotive software to applied AI to a product of my own.</p>
		<div class="timeline">
			{
				EXPERIENCE.map((role) => (
					<details class="role">
						<summary>
							<span class="dot" aria-hidden="true" />
							<span class="period">{role.period}</span>
							<span class="detail">
								<span class="title">{role.title}</span>
								<span class="lead">{role.summary}</span>
							</span>
							<span class="chevron" aria-hidden="true" />
						</summary>
						<div class="more">
							{role.body.map((paragraph) => (
								<p>{paragraph}</p>
							))}
							<p class="tags">
								{role.tags.split(' · ').map((tag) => (
									<span class="pill">{tag}</span>
								))}
							</p>
						</div>
					</details>
				))
			}
		</div>
	</section>
</Base>

<style>
	.intro {
		color: var(--muted);
		margin-bottom: 3rem;
	}

	.project {
		margin-bottom: 1.5rem;
		padding: 2rem;
	}

	.building {
		background: var(--tint);
		border-color: transparent;
		margin-bottom: 3rem;
	}

	.building h2 {
		margin-bottom: 0.75rem;
	}

	.building ul {
		color: var(--ink);
	}

	.experience {
		padding-bottom: 2rem;
	}

	.experience h2 {
		margin-bottom: 0.25rem;
	}

	.experience .intro {
		margin-bottom: 1.5rem;
	}

	/* Roles as a timeline: a vertical hairline with a pine dot per role.
	   Native <details>, so the disclosure costs no JavaScript. */
	.timeline {
		position: relative;
		padding-left: 1.75rem;
	}

	.timeline::before {
		content: '';
		position: absolute;
		left: 0.4rem;
		top: 1.5rem;
		bottom: 1.5rem;
		width: 2px;
		background: var(--hairline);
	}

	.role {
		position: relative;
		border-bottom: 1px solid var(--hairline);
	}

	.role:last-child {
		border-bottom: 0;
	}

	.dot {
		position: absolute;
		left: -1.75rem;
		top: 1.55rem;
		width: 0.85rem;
		height: 0.85rem;
		border-radius: 50%;
		background: var(--bg);
		border: 2.5px solid var(--accent);
	}

	.role[open] .dot {
		background: var(--accent);
	}

	summary {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 0.25rem 1.5rem;
		padding-block: 1.25rem;
		cursor: pointer;
		list-style: none;
	}

	/* Safari still paints its own triangle without this. */
	summary::-webkit-details-marker {
		display: none;
	}

	summary:hover .title,
	.role[open] .title {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	summary:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.period {
		flex: 0 0 6.5rem;
		font-family: var(--font-sans);
		font-size: 0.875rem;
		font-variant-numeric: tabular-nums;
		color: var(--muted);
		padding-top: 0.15rem; /* optically aligns with the title's cap height */
	}

	.detail {
		flex: 1 1 16rem;
	}

	.title {
		display: block;
		font-family: var(--font-serif);
		font-size: var(--step-1);
		font-weight: 600;
		margin-bottom: 0.2rem;
	}

	.lead {
		display: block;
		color: var(--muted);
	}

	.chevron {
		flex: 0 0 auto;
		width: 0.5rem;
		height: 0.5rem;
		margin-top: 0.4rem;
		border-right: 1.5px solid var(--muted);
		border-bottom: 1.5px solid var(--muted);
		transform: rotate(45deg);
		transition: transform 0.15s ease;
	}

	.role[open] .chevron {
		transform: rotate(-135deg);
	}

	/* Indented to the text column so expanded prose lines up with the summary. */
	.more {
		padding-left: 8rem;
		padding-bottom: 1.5rem;
	}

	.more p {
		color: var(--muted);
		margin-bottom: 0.7rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 1rem;
		margin-bottom: 0;
	}

	.pill {
		font-size: 0.8125rem;
		font-weight: 600;
		padding: 0.2rem 0.6rem;
		border-radius: 999px;
		background: var(--tint);
		color: var(--accent);
	}

	@media (max-width: 34rem) {
		.more {
			padding-left: 0;
		}
	}

	h2 {
		font-size: var(--step-2);
		margin: 0.35rem 0 0.75rem;
	}

	.copy > p {
		color: var(--muted);
	}

	/* Screenshot beside the prose. The copy's 22rem basis is what forces the wrap,
	   so on a narrow screen the shot drops below instead of squeezing the text. */
	.cols {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 2.5rem;
	}

	.copy {
		flex: 1 1 24rem;
	}

	/* Phones fanned as on the home page: each sits a little lower and overlaps the
	   last, so three of them fill the column instead of floating in it. The group
	   wraps under the copy on narrow screens. */
	.shots {
		flex: 1 1 20rem;
		display: flex;
		justify-content: center;
		align-items: flex-start;
		padding-bottom: 3rem;
	}

	.shots a {
		display: block;
		width: 44%;
		max-width: 220px;
		margin-left: -10%;
		transform: translateY(calc(var(--i) * 1.5rem));
	}

	.shots a:first-child {
		margin-left: 0;
	}

	.shots img {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--hairline);
		border-radius: 18px;
		box-shadow: 0 12px 30px rgb(0 0 0 / 0.18);
		background: var(--surface);
	}

	.shots a:hover img {
		border-color: var(--accent);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin: 1.25rem 0 0;
	}

	ul {
		margin: 0;
		padding-left: 1.25rem;
		color: var(--muted);
	}

	li {
		margin-bottom: 0.5rem;
	}
</style>
