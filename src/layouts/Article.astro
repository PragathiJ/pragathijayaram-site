---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import Button from '../components/Button.astro';
import Contents from '../components/Contents.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { AUTHOR } from '../consts';
import { getGroup } from '../data/groups';
import type { Article } from '../lib/articles';

interface Props {
	article: Article;
	headings?: MarkdownHeading[];
}

const { article, headings = [] } = Astro.props;
const { title, description, pubDate, updatedDate, group, type, ogImage } = article.data;
const parent = getGroup(group);
---

<Base
	title={title}
	description={description}
	ogImage={ogImage}
	pubDate={pubDate}
	updatedDate={updatedDate}
>
	<article>
		<p class="eyebrow breadcrumb">
			<a href={`/articles#${group}`}>{parent?.name}</a>
		</p>
		<h1>{title}</h1>
		<p class="meta byline">
			<span class="who">{AUTHOR.name}</span>
			<span aria-hidden="true">·</span>
			<FormattedDate date={pubDate} />
			<span aria-hidden="true">·</span>
			<span>{type}</span>
			{
				updatedDate && (
					<span>
						Updated <FormattedDate date={updatedDate} />
					</span>
				)
			}
		</p>
		<Contents headings={headings} />
		<div class="prose">
			<slot />
		</div>
	</article>
	<footer class="author card">
		<img
			class="portrait"
			src="/pragathi-avatar.jpg"
			alt=""
			width="56"
			height="56"
			loading="lazy"
			decoding="async"
		/>
		<p class="name">Pragathi Jayaram</p>
		<p class="bio">
			Applied AI systems consultant, product engineer and founder. 10 years across production AI,
			mobile and backend systems, most recently building and shipping Anovi end to end.
		</p>
		<p class="meta links">
			<a href="/articles">More articles</a>
			<span aria-hidden="true">·</span>
			<a href="/about">About</a>
		</p>
	</footer>
	<aside class="cta card">
		<div>
			<p class="eyebrow">Work with me</p>
			<p class="cta-text">
				Have an app that needs to get to the stores, or one that is stuck there? Fixed-scope
				reviews, fixes and builds, from someone who has shipped one.
			</p>
		</div>
		<Button href="/services" primary icon="arrow">See the packages</Button>
	</aside>
</Base>

<style>
	.breadcrumb {
		margin-bottom: 0.5rem;
	}

	.breadcrumb a {
		color: inherit;
		text-decoration: none;
	}

	.breadcrumb a:hover {
		text-decoration: underline;
	}

	.byline {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 2rem;
	}

	.byline .who {
		color: var(--ink);
	}

	/* Portrait sits in a grid column so the name, bio and links all align to one
	   edge; on narrow screens it moves above them instead of squeezing the text. */
	.author {
		display: grid;
		grid-template-columns: 56px 1fr;
		column-gap: 1rem;
		margin-top: 3rem;
	}

	.cta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 1.5rem;
		margin-top: 1.25rem;
		background: var(--tint);
		border-color: transparent;
	}

	.cta-text {
		margin: 0.25rem 0 0;
		max-width: 30rem;
	}

	.portrait {
		grid-row: 1 / span 3;
		width: 56px;
		height: 56px;
		border-radius: 50%;
		object-fit: cover;
	}

	.author .name {
		font-family: var(--font-serif);
		font-size: var(--step-1);
		margin-bottom: 0.35rem;
	}

	@media (max-width: 28rem) {
		.author {
			grid-template-columns: 1fr;
		}

		.portrait {
			grid-row: auto;
			margin-bottom: 0.75rem;
		}
	}

	.author .bio {
		color: var(--muted);
		margin-bottom: 0.75rem;
		font-size: 0.9375rem;
	}

	.author .links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
	}
</style>
