---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import Contents from '../components/Contents.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { AUTHOR } from '../consts';
import { getGroup } from '../data/groups';
import type { Article } from '../lib/articles';

interface Props {
	article: Article;
	headings?: MarkdownHeading[];
}

const { article, headings = [] } = Astro.props;
const { title, description, pubDate, updatedDate, group, type, ogImage } = article.data;
const parent = getGroup(group);
---

<Base
	title={title}
	description={description}
	ogImage={ogImage}
	pubDate={pubDate}
	updatedDate={updatedDate}
>
	<article>
		<p class="meta breadcrumb">
			<a href={`/articles#${group}`}>{parent?.name}</a>
		</p>
		<h1>{title}</h1>
		<p class="meta byline">
			<span class="who">{AUTHOR.name}</span>
			<span aria-hidden="true">·</span>
			<FormattedDate date={pubDate} />
			<span aria-hidden="true">·</span>
			<span>{type}</span>
			{
				updatedDate && (
					<span>
						Updated <FormattedDate date={updatedDate} />
					</span>
				)
			}
		</p>
		<Contents headings={headings} />
		<div class="prose">
			<slot />
		</div>
	</article>
	<footer class="author">
		<p class="name">Pragathi Jayaram</p>
		<p class="bio">
			Applied AI systems consultant, product engineer and founder. 10 years across production AI,
			mobile and backend systems, most recently building and shipping Anovi end to end.
		</p>
		<p class="meta links">
			<a href="/articles">More articles</a>
			<span aria-hidden="true">·</span>
			<a href="/services">Work with me</a>
			<span aria-hidden="true">·</span>
			<a href="/about">About</a>
		</p>
	</footer>
</Base>

<style>
	.breadcrumb {
		margin-bottom: 0.5rem;
	}

	.breadcrumb a {
		color: var(--muted);
		text-decoration: none;
	}

	.breadcrumb a:hover {
		color: var(--ink);
	}

	.byline {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 2rem;
	}

	.byline .who {
		color: var(--ink);
	}

	.author {
		border-top: 1px solid var(--hairline);
		padding-top: 1.5rem;
		margin-top: 3rem;
	}

	.author .name {
		font-family: var(--font-serif);
		font-size: var(--step-1);
		margin-bottom: 0.35rem;
	}

	.author .bio {
		color: var(--muted);
		margin-bottom: 0.75rem;
	}

	.author .links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
	}
</style>
