{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pragathijayaram-site",
	"compatibility_date": "2026-08-01",
	// Assets-only Worker: no server code runs. Cloudflare serves the static
	// files Astro generates into ./dist straight from its edge network.
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	// The site is served from pragathijayaram.com only. Leaving workers.dev on
	// would publish the same pages at a second address.
	"workers_dev": false,
	"preview_urls": false
}
